# ---- TMDB ----
# Server-side only (read by /api/tmdb.js). Never prefix this with VITE_ —
# that would bundle it into client JS and expose it to anyone using the site.
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_KEY=

# ---- Auth ----
# Random secret used to sign session (JWT) cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- Database (MySQL — Aiven or any MySQL-compatible host) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
